              "id": "a16-cond-lambat",
              "leftValue": "={{ $json.duration_ms }}",
              "rightValue": 60000,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a16-terlalu-lambat",
      "name": "Terlalu Lambat?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1460, -300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://mock-api:8080/notify",
        "authentication": "genericCredentialType",
