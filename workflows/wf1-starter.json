    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO core.orders (order_id, customer_id, merchant_id, zone, order_date, created_at, status, total_amount, payment_status, customer_note)\nVALUES ($1,$2,$3,(SELECT zone FROM core.merchants WHERE merchant_id = $3),CURRENT_DATE,now(),'active',$4,'unpaid',$5)\nON CONFLICT (order_id) DO NOTHING\nRETURNING order_id;",
        "options": {
          "queryReplacement": "={{ [$('Webhook order.created').item.json.body.order_id, $('Webhook order.created').item.json.body.customer_id, $('Webhook order.created').item.json.body.merchant_id, $('Webhook order.created').item.json.body.total_amount, $('Webhook order.created').item.json.body.customer_note || ''] }}"
        }
      },
      "id": "b9-catat-order",
      "name": "Catat Order",
