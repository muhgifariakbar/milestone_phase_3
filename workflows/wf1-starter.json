        "jsonBody": "={{ { \"channel\": \"merchant-ops\", \"title\": \"Produk habis baru\", \"text\": $('Catat Sync Run').item.json.new_stockouts + \" baris stok 0 pada sinkron ini.\" } }}",
        "options": {}
      },
      "id": "a20-laporkan-produk-habis",
