      "name": "Ambil Daftar Merchant",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [-960, -300],
      "credentials": { "postgres": { "id": "GANTI-ID-PG-OPS-WRITER", "name": "Postgres ops_writer" } }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT product_id, sku, price FROM core.products;"
      },
      "id": "a9-ambil-katalog-produk",
      "name": "Ambil Katalog Produk",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [-960, -480],
      "credentials": { "postgres": { "id": "GANTI-ID-PG-OPS-WRITER", "name": "Postgres ops_writer" } }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://mock-api:8080/merchants/' + $json.merchant_id + '/stock' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "retry": { "retryOnFail": true, "maxTries": 4, "waitBetweenTries": 1000 }
        }
      },
      "id": "a3h-ambil-stok-merchant-api",
      "name": "Ambil Stok Merchant API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-740, -300],
      "onError": "continueErrorOutput",
      "credentials": { "httpHeaderAuth": { "id": "GANTI-ID-HEADER-AUTH-MOCK-API", "name": "Header Auth Mock API (X-Api-Key)" } }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO ops.dead_letter(workflow, node, execution_id, business_key, error_message, payload, attempts)\nVALUES ($1,$2,$3,$4,$5,$6::jsonb,$7)\nRETURNING business_key AS merchant_id, error_message;",
        "options": {
          "queryReplacement": "={{ ['WF1', 'Ambil Stok Merchant API', $execution.id, $json.merchant_id, $json.error ? ($json.error.message || JSON.stringify($json.error)) : 'request failed', $json, 4] }}"
        }
      },
      "id": "a5-catat-dead-letter",
      "name": "Catat Dead-Letter",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [-520, -160],
      "credentials": { "postgres": { "id": "GANTI-ID-PG-OPS-WRITER", "name": "Postgres ops_writer" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://mock-api:8080/notify",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"channel\": \"ops-alerts\", \"title\": \"Sinkron stok gagal: \" + $json.merchant_id, \"text\": \"Merchant \" + $json.merchant_id + \" gagal setelah retry. Error: \" + $json.error_message } }}",
        "options": {}
      },
      "id": "a6-alert-merchant-gagal",
      "name": "Alert Merchant Gagal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-300, -160],
      "continueOnFail": true,
      "credentials": { "httpHeaderAuth": { "id": "GANTI-ID-HEADER-AUTH-MOCK-API", "name": "Header Auth Mock API (X-Api-Key)" } }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const entry of $input.all()) {\n  const raw = entry.json;\n  const items = Array.isArray(raw.items) ? raw.items : [];\n  if (items.length === 0) {\n    out.push({ json: { merchant_id: raw.merchant_id, baris_kosong: true } });\n    continue;\n  }\n  for (const it of items) {\n    out.push({\n      json: {\n        merchant_id: raw.merchant_id,\n        sku: String(it.sku).toUpperCase(),\n        qty: parseInt(it.qty, 10) || 0,\n        synced_at: raw.as_of || new Date().toISOString(),\n        baris_kosong: false,\n      },\n    });\n  }\n}\nreturn out;"
      },
      "id": "a7-normalisasi-stok",
      "name": "Normalisasi Stok",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-520, -440]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "a8-cond-baris",
              "leftValue": "={{ $json.baris_kosong }}",
              "rightValue": false,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a8-ada-baris-stok",
      "name": "Ada Baris Stok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-300, -440]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://mock-api:8080/notify",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"channel\": \"ops-alerts\", \"title\": \"Sinkron 0 baris: \" + $json.merchant_id, \"text\": \"Merchant \" + $json.merchant_id + \" mengembalikan 0 item - kemungkinan outage diam-diam.\" } }}",
        "options": {}
      },
      "id": "a12-gagal-sinkron-0-baris",
      "name": "Gagal: Sinkron 0 Baris",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-80, -560],
      "continueOnFail": true,
      "credentials": { "httpHeaderAuth": { "id": "GANTI-ID-HEADER-AUTH-MOCK-API", "name": "Header Auth Mock API (X-Api-Key)" } }
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByFields",
        "fieldsToMatchString": "sku",
        "joinMode": "keepMatches",
        "outputDataFrom": "both",
        "options": {}
      },
      "id": "a10-gabungkan-katalog",
      "name": "Gabungkan Katalog",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [-80, -440]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT $1::text AS merchant_id, $2::text AS product_id, $3::int AS qty_baru, $4::timestamptz AS synced_at, s.qty AS qty_lama\nFROM (SELECT 1) x\nLEFT JOIN core.merchant_stock s ON s.merchant_id = $1 AND s.product_id = $2;",
        "options": {
          "queryReplacement": "={{ [$json.merchant_id, $json.product_id, $json.qty, $json.synced_at] }}"
        }
      },
      "id": "a10b-ambil-stok-lama",
      "name": "Ambil Stok Lama",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [120, -440],
      "credentials": { "postgres": { "id": "GANTI-ID-PG-OPS-WRITER", "name": "Postgres ops_writer" } }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((entry) => {\n  const j = entry.json;\n  const newStockout = j.qty_lama !== null && Number(j.qty_lama) > 0 && Number(j.qty_baru) === 0;\n  return { json: { ...j, new_stockout: newStockout } };\n});"
      },
      "id": "a10c-deteksi-stok-habis-baru",
      "name": "Deteksi Stok Habis Baru",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [340, -440]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO core.merchant_stock (merchant_id, product_id, qty, synced_at)\nVALUES ($1,$2,$3,$4)\nON CONFLICT (merchant_id, product_id) DO UPDATE SET qty = EXCLUDED.qty, synced_at = EXCLUDED.synced_at\nRETURNING merchant_id, product_id;",
        "options": {
          "queryReplacement": "={{ [$json.merchant_id, $json.product_id, $json.qty_baru, $json.synced_at] }}"
        }
      },
      "id": "a11-upsert-stok",
      "name": "Upsert Stok",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [560, -440],
      "credentials": { "postgres": { "id": "GANTI-ID-PG-OPS-WRITER", "name": "Postgres ops_writer" } }
    },
    {
      "parameters": { "mode": "append", "numberInputs": 3, "options": {} },
      "id": "a13-gabung-hasil-merchant",
      "name": "Gabung Hasil Merchant",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [800, -300]
    },
    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst start = sd.sync_start || Date.now();\nconst duration_ms = Date.now() - start;\nreturn [{ json: { duration_ms } }];"
      },
      "id": "a14-hitung-durasi",
      "name": "Hitung Durasi",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1020, -300],
      "executeOnce": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO ops.sync_runs (run_at, merchants_total, merchants_ok, rows_synced, new_stockouts, duration_ms)\nSELECT now(),\n (SELECT COUNT(*) FROM core.merchants WHERE active),\n (SELECT COUNT(DISTINCT merchant_id) FROM core.merchant_stock WHERE synced_at >= now() - interval '20 minutes'),\n (SELECT COUNT(*) FROM core.merchant_stock WHERE synced_at >= now() - interval '20 minutes'),\n (SELECT COUNT(*) FROM core.merchant_stock WHERE synced_at >= now() - interval '20 minutes' AND qty = 0),\n $1\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ [$json.duration_ms] }}"
        }
      },
      "id": "a15-catat-sync-run",
      "name": "Catat Sync Run",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1240, -300],
      "executeOnce": true,
      "credentials": { "postgres": { "id": "GANTI-ID-PG-OPS-WRITER", "name": "Postgres ops_writer" } }
    },
