    {
      "parameters": {
        "jsCode": "const d = $json;\nconst pct = (x) => (x == null ? 'N/A' : (Number(x) * 100).toFixed(1) + '%');\nconst alasan = Array.isArray(d.alasan_batal_teratas) ? d.alasan_batal_teratas : [];\nconst alasanText = alasan.length\n  ? alasan.map((a, i) => `${i + 1}. ${a.cancel_reason} (${a.jumlah}x)`).join('\\n')\n  : '-';\nconst pesan = `*Digest Ops H8Mart - ${d.tanggal}*\\n\\nTotal order: ${d.total_order}\\nOrder batal: ${d.order_batal} (${pct(d.cancel_rate)})\\nSLA 30 menit: ${pct(d.sla_30_menit)}\\n\\nAlasan batal teratas:\\n${alasanText}`;\nreturn [{ json: { pesan, tanggal: d.tanggal, total_order: d.total_order } }];"
      },
