      "id": "c1-jadwal-digest",
      "name": "Jadwal Digest 07.00 WIB",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1400, 960]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n (SELECT hari_data_terakhir FROM core.data_info) AS tanggal,\n COUNT(*)::int AS total_order,\n COUNT(*) FILTER (WHERE status IN ('cancelled','failed'))::int AS order_batal,\n ROUND(COUNT(*) FILTER (WHERE status IN ('cancelled','failed'))::numeric / NULLIF(COUNT(*),0),4)::float AS cancel_rate,\n COUNT(*) FILTER (WHERE status = 'delivered')::int AS order_delivered,\n (SELECT ROUND(COUNT(*) FILTER (WHERE d.actual_minutes <= d.promised_minutes)::numeric / NULLIF(COUNT(*),0),4)::float\n  FROM core.orders o2 JOIN core.deliveries d ON d.order_id = o2.order_id\n  WHERE o2.status = 'delivered' AND o2.order_date = (SELECT hari_data_terakhir FROM core.data_info)) AS sla_30_menit,\n (SELECT json_agg(t) FROM (\n    SELECT cancel_reason, COUNT(*)::int AS jumlah\n    FROM core.orders\n    WHERE order_date = (SELECT hari_data_terakhir FROM core.data_info) AND status IN ('cancelled','failed')\n    GROUP BY cancel_reason ORDER BY jumlah DESC LIMIT 3\n  ) t) AS alasan_batal_teratas\nFROM core.orders\nWHERE order_date = (SELECT hari_data_terakhir FROM core.data_info);"
      },
      "id": "c2-hitung-kpi-harian",
      "name": "Hitung KPI Harian",
      "type": "n8n-nodes-base.postgres",
