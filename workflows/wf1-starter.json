    },

    {
      "parameters": {
        "content": "## WF1 - Jalur B: Order Masuk\n\nKontrak HTTP lengkap: 422 (event tidak valid), 200 duplikat (idempotent terhadap order_id yang sama dikirim dua kali), 409 (stok habis), 200 diterima (cukup/tipis, field `peringatan` muncul bila tipis).\n\n**Kebijakan stok tipis (dokumentasikan di docs/02):** sisa stok setelah order <= 2 unit untuk SKU manapun di order itu -> `peringatan: stok_tipis`, order tetap diterima.",
        "height": 300,
        "width": 480
      },
      "id": "sb-sticky",
      "name": "Sticky Note Jalur B",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-1400, 140]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "order-created",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b1-webhook-order-created",
      "name": "Webhook order.created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1400, 400],
      "webhookId": "order-created",
      "credentials": { "httpHeaderAuth": { "id": "GANTI-ID-HEADER-AUTH-WEBHOOK", "name": "Header Auth H8Mart Webhook" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "b2-cond-event",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "order.created",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "b2-cond-order-id",
              "leftValue": "={{ $json.body.order_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            },
            {
              "id": "b2-cond-merchant-id",
              "leftValue": "={{ $json.body.merchant_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            },
            {
              "id": "b2-cond-items",
              "leftValue": "={{ Array.isArray($json.body.items) && $json.body.items.length > 0 }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2-event-valid",
      "name": "Event Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-1160, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"tidak_valid\" } }}",
        "options": { "responseCode": 422 }
      },
      "id": "b10-respon-422",
      "name": "Respon 422 Tidak Valid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [-1160, 580]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT $1::text AS order_id, EXISTS(SELECT 1 FROM core.orders WHERE order_id = $1) AS sudah_ada;",
        "options": { "queryReplacement": "={{ [$json.body.order_id] }}" }
      },
      "id": "b3-cek-order-duplikat",
      "name": "Cek Order Duplikat",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [-940, 400],
      "credentials": { "postgres": { "id": "GANTI-ID-PG-OPS-WRITER", "name": "Postgres ops_writer" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "b4-cond-sudah-ada",
              "leftValue": "={{ $json.sudah_ada }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b4-order-sudah-ada",
      "name": "Order Sudah Ada?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-720, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"diterima\", \"duplikat\": true } }}",
        "options": { "responseCode": 200 }
      },
      "id": "b4a-respon-200-duplikat",
      "name": "Respon 200 Diterima (Duplikat)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [-720, 580]
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook order.created').item.json.body;\nconst items = Array.isArray(body.items) ? body.items : [];\nreturn items.map((it) => ({\n  json: {\n    order_id: body.order_id,\n    merchant_id: body.merchant_id,\n    customer_id: body.customer_id,\n    total_amount: body.total_amount,\n    customer_note: body.customer_note || null,\n    sku: it.sku,\n    requested_qty: it.qty,\n  },\n}));"
      },
      "id": "b5-siapkan-item-order",
      "name": "Siapkan Item Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-500, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT $3::text AS order_id, $1::text AS merchant_id, $2::text AS sku, $4::int AS requested_qty, p.product_id, COALESCE(ms.qty,0) AS qty_tersedia\nFROM core.products p\nLEFT JOIN core.merchant_stock ms ON ms.product_id = p.product_id AND ms.merchant_id = $1\nWHERE p.sku = $2;",
        "options": {
          "queryReplacement": "={{ [$json.merchant_id, $json.sku, $json.order_id, $json.requested_qty] }}"
        }
      },
      "id": "b6-cek-stok-tiap-item",
      "name": "Cek Stok Tiap Item",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [-280, 300],
      "credentials": { "postgres": { "id": "GANTI-ID-PG-OPS-WRITER", "name": "Postgres ops_writer" } }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map((e) => e.json);\nlet habis = false;\nlet tipis = false;\nfor (const r of rows) {\n  const tersedia = Number(r.qty_tersedia);\n  const diminta = Number(r.requested_qty);\n  if (tersedia < diminta) habis = true;\n  else if (tersedia - diminta <= 2) tipis = true;\n}\nconst status = habis ? 'habis' : (tipis ? 'tipis' : 'cukup');\nreturn [{\n  json: {\n    order_id: rows[0] ? rows[0].order_id : null,\n    merchant_id: rows[0] ? rows[0].merchant_id : null,\n    stok_status: status,\n    items: rows,\n  },\n}];"
      },
