      "typeVersion": 2.6,
      "position": [380, 300],
      "credentials": { "postgres": { "id": "GANTI-ID-PG-OPS-WRITER", "name": "Postgres ops_writer" } }
    },
    {
      "parameters": {
        "jsCode": "const items = $('Evaluasi Stok').item.json.items || [];\nconst orderId = $('Evaluasi Stok').item.json.order_id;\nreturn items.map((it) => ({\n  json: {\n    order_id: orderId,\n    product_id: it.product_id,\n    qty: it.requested_qty,\n  },\n}));"
      },
