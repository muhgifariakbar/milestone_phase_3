        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"channel\": \"ops-alerts\", \"title\": \"Sinkron stok lambat\", \"text\": \"Durasi sinkron \" + $json.duration_ms + \"ms melebihi ambang.\" } }}",
        "options": {}
      },
